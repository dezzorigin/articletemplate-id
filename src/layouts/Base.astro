---
// Layout publik BARU (redesign v2, pola "Classic Header with Sheet Menu"
// 21st.dev/@ln-dev7/components/header-17 — komposisi ditiru, dibangun ulang
// Astro + CSS biasa; registry header-17.json tidak bisa di-fetch, jadi tidak
// ada kode registry yang diadaptasi).
// Logo kiri, nav tengah, ghost "Masuk"/"Akun" + pill CTA hitam "Beli Template"
// di kanan; di HP hamburger membuka sheet menu geser dari kanan. Bottom tab
// bar lama DIHAPUS (duplikasi nav atas + tab bawah yang dinilai kacau).
// Nav: Beranda, Template, Harga (+ Masuk / Akun sesuai status login).
// Token: hitam-putih + krem hangat + SATU aksen oranye hangat; serif editorial
// untuk headline, sans bersih untuk UI; tanpa gradien.
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Template artikel untuk peneliti: beli, bayar, unduh, dan kelola dari akunmu.',
} = Astro.props;
const path = Astro.url.pathname;
const loggedIn = Boolean(Astro.locals.user);
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/templates', label: 'Template' },
  { href: '/harga', label: 'Harga' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#fbfaf7" />
    <meta name="color-scheme" content="light" />
    <title>{title} — ArticleTemplate.id</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — ArticleTemplate.id`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <style is:global>
      :root {
        --paper: #fbfaf7;
        --surface: #ffffff;
        --ink: #1c1917;
        --muted: #5b6470;
        --line: #e7e2d6;
        --line-strong: #d5cfbf;
        --accent: #c2410c;
        --accent-dark: #9a3412;
        --accent-soft: #fdefe4;
        --btn-bg: #1c1917;
        --btn-ink: #fbfaf7;
        --warn-bg: #f6f1e4;
        --warn-line: #dcd0ad;
        --warn-ink: #5e4a14;
        --code-bg: #f1efe9;
        --st-ok-bg: #1c1917;
        --st-ok-line: #1c1917;
        --st-ok-ink: #fbfaf7;
        --st-wait-bg: #fdefe4;
        --st-wait-line: #f0c9a8;
        --st-wait-ink: #9a3412;
        --st-bad-bg: #fdf0ed;
        --st-bad-line: #e8c4bc;
        --st-bad-ink: #8a2f23;
        --st-mut-bg: #f1efe9;
        --st-mut-line: #e7e2d6;
        --st-mut-ink: #5b6470;
        --ok-soft-bg: #fdefe4;
        --ok-soft-line: #f0c9a8;
        --ok-soft-ink: #9a3412;
        --mono: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
        --gutter: 16px;
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-tap-highlight-color: transparent;
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--paper);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.65;
        overflow-wrap: anywhere;
      }
      a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--line-strong);
        text-underline-offset: 3px;
      }
      a,
      button,
      [role="button"] {
        touch-action: manipulation;
      }
      img,
      svg,
      video {
        max-width: 100%;
      }
      input,
      textarea,
      select {
        font: inherit;
        font-size: 16px;
        min-height: 44px;
      }
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 6px;
      }
      .skip {
        position: absolute;
        left: var(--gutter);
        top: -60px;
        background: var(--btn-bg);
        color: var(--btn-ink);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        z-index: 100;
      }
      .skip:focus {
        top: 8px;
      }

      /* ---------- layout ---------- */
      .wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 var(--gutter);
        padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
        padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
        padding-bottom: 3rem;
      }

      /* ---------- header-17: logo kiri, nav tengah, aksi kanan ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(251, 250, 247, 0.96);
        border-bottom: 1px solid var(--line);
        padding-top: env(safe-area-inset-top, 0px);
      }
      .header-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0.65rem var(--gutter);
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 1rem;
      }
      .brand a {
        color: var(--ink);
        text-decoration: none;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.35rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
      }
      .brand a em {
        font-style: normal;
        color: var(--accent);
      }
      .site-nav {
        display: none;
      }
      .header-actions {
        display: none;
      }
      .menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        margin-left: auto;
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        cursor: pointer;
      }
      .menu-btn svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
      }

      /* ---------- sheet menu (mobile) ---------- */
      .sheet-overlay {
        position: fixed;
        inset: 0;
        z-index: 90;
        background: rgba(28, 25, 23, 0.45);
        opacity: 0;
        pointer-events: none;
        transition: opacity 180ms var(--ease-out);
      }
      .sheet {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 95;
        width: min(320px, 88vw);
        background: var(--surface);
        border-left: 1px solid var(--line);
        padding: 1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        transform: translateX(100%);
        transition: transform 220ms var(--ease-out);
        overflow-y: auto;
      }
      .sheet.open {
        transform: translateX(0);
      }
      .sheet-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }
      .sheet-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 0.75rem;
      }
      .sheet-head .brand a {
        font-size: 1.15rem;
      }
      .sheet-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        cursor: pointer;
      }
      .sheet-close svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
      }
      .sheet nav {
        display: flex;
        flex-direction: column;
      }
      .sheet nav a {
        display: flex;
        align-items: center;
        min-height: 52px;
        color: var(--ink);
        text-decoration: none;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.25rem;
        font-weight: 500;
        border-bottom: 1px solid var(--line);
      }
      .sheet nav a.active {
        color: var(--accent-dark);
      }
      .sheet-actions {
        display: grid;
        gap: 0.6rem;
        margin-top: 1.25rem;
      }
      .sheet-actions .btn {
        width: 100%;
      }
      .sheet-foot {
        margin-top: auto;
        padding-top: 1.25rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .sheet-foot a {
        color: var(--muted);
      }

      main {
        padding-top: 1.5rem;
      }
      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.7rem, 6vw, 2.7rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
      }
      h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.3;
        margin: 2rem 0 0.75rem;
      }
      p {
        margin: 0 0 1rem;
      }
      ol {
        padding-left: 1.4rem;
      }
      ol li {
        margin-bottom: 0.5rem;
      }
      code {
        background: var(--code-bg);
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        font-size: 0.9em;
      }
      .badge {
        display: inline-block;
        border: 1px solid var(--line);
        color: var(--muted);
        padding: 0.05rem 0.5rem;
        border-radius: 4px;
        font-family: var(--mono);
        font-size: 0.78rem;
        font-weight: 400;
        white-space: nowrap;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
        margin: 1rem 0;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1rem 1.25rem;
      }
      .grid .card {
        margin: 0;
      }
      .card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.08rem;
      }
      .card p {
        color: var(--muted);
      }
      .card p:last-child {
        margin-bottom: 0;
      }
      button,
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        background: var(--btn-bg);
        color: var(--btn-ink);
        border: 0;
        border-radius: 999px;
        padding: 0.6rem 1.25rem;
        font: inherit;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        transition: transform 120ms var(--ease-out), background 120ms;
      }
      button:active,
      .btn:active {
        transform: scale(0.97);
      }
      button:disabled {
        background: #e7e5e4;
        color: #57534e;
        cursor: not-allowed;
        transform: none;
      }
      /* ---------- form + pesan (dipakai halaman auth dll) ---------- */
      .form {
        display: grid;
        gap: 0.9rem;
        max-width: 420px;
      }
      .form .field {
        display: grid;
        gap: 0.3rem;
        font-weight: 500;
        font-size: 0.9rem;
      }
      .form .field input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.5rem 0.8rem;
        background: var(--surface);
        color: var(--ink);
        font-weight: 400;
      }
      .form .hint {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 400;
      }
      .notice {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin: 0 0 1rem;
        background: var(--warn-bg);
        border: 1px solid var(--warn-line);
        color: var(--warn-ink);
      }
      .notice.ok {
        background: var(--ok-soft-bg);
        border-color: var(--ok-soft-line);
        color: var(--ok-soft-ink);
      }
      .linkrow {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        margin-top: 1rem;
      }
      .linkrow a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .btn.ghost {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--line-strong);
      }
      /* ---------- komponen bersama (dipakai landing / harga / checkout) ---------- */
      /* RadioGroup berupa kartu: satu fieldset, label kartu per pilihan. */
      .radios {
        border: 0;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.5rem;
      }
      .radios legend {
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0;
        margin-bottom: 0.25rem;
      }
      .radio-card {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        cursor: pointer;
        font-weight: 500;
        min-height: 44px;
      }
      .radio-card input {
        accent-color: var(--accent);
        width: 18px;
        height: 18px;
        flex: none;
        margin-top: 0.15rem;
        min-height: 0;
      }
      .radio-card small {
        display: block;
        color: var(--muted);
        font-weight: 400;
        font-size: 0.85rem;
      }
      .radio-card:has(input:checked) {
        border-color: var(--accent);
        background: var(--accent-soft);
      }
      .radio-card:has(input:focus-visible) {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
      /* Kartu status besar (halaman status pesanan): ikon + kata status + penjelasan. */
      .status-card {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 0.75rem;
        align-items: start;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin: 0 0 1rem;
      }
      .status-card h2 {
        margin: 0 0 0.25rem;
        font-size: 1.3rem;
      }
      .status-card p {
        margin: 0;
        color: var(--muted);
      }
      .status-card p:last-child {
        margin-bottom: 0;
      }
      .status-ico {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-soft);
        color: var(--accent-dark);
      }
      .status-ico svg {
        width: 26px;
        height: 26px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .status-card.ok .status-ico {
        background: var(--accent-soft);
        color: var(--accent-dark);
      }
      .status-card.bad .status-ico {
        background: var(--st-bad-bg);
        color: var(--st-bad-ink);
      }
      .status-card.wait .status-ico {
        background: var(--warn-bg);
        color: var(--warn-ink);
      }
      /* Hitung mundur kedaluwarsa bayar: mono, angka tabular. */
      .countdown {
        font-family: var(--mono);
        font-size: 1.05rem;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
      }
      /* Sel centang di tabel perbandingan. */
      .ya {
        color: var(--accent-dark);
        font-weight: 700;
      }
      .footlinks { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
      .footlinks a { min-height: 44px; display: inline-flex; align-items: center; }
      footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-size: 0.9rem;
        color: var(--muted);
      }
      footer p {
        margin: 0;
      }

      /* ---------- hover hanya untuk mouse ---------- */
      @media (hover: hover) and (pointer: fine) {
        a:hover {
          text-decoration-color: var(--accent);
        }
        .site-nav a:hover {
          background: var(--code-bg);
        }
        button:not(:disabled):hover,
        .btn:hover {
          background: #000;
        }
        .btn.ghost:hover {
          background: var(--code-bg);
        }
      }

      /* ---------- layar lebar: nav tengah ---------- */
      @media (min-width: 860px) {
        :root {
          --gutter: 24px;
        }
        .header-inner {
          grid-template-columns: 1fr auto 1fr;
          padding-top: 0.7rem;
          padding-bottom: 0.7rem;
        }
        .site-nav {
          display: flex;
          gap: 0.15rem;
          justify-self: center;
        }
        .site-nav a {
          display: inline-flex;
          align-items: center;
          min-height: 44px;
          color: var(--muted);
          text-decoration: none;
          font-weight: 500;
          font-size: 0.95rem;
          padding: 0 0.9rem;
          border-radius: 999px;
        }
        .site-nav a.active {
          background: var(--code-bg);
          color: var(--ink);
        }
        .header-actions {
          display: flex;
          align-items: center;
          justify-self: end;
          gap: 0.25rem;
        }
        .header-actions .ghost-link {
          display: inline-flex;
          align-items: center;
          min-height: 44px;
          padding: 0 0.9rem;
          color: var(--ink);
          text-decoration: none;
          font-weight: 500;
          font-size: 0.95rem;
          border-radius: 999px;
        }
        .header-actions .ghost-link:hover {
          background: var(--code-bg);
        }
        .menu-btn {
          display: none;
        }
        main {
          padding-top: 2.5rem;
        }
        .grid {
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
        }
        .card {
          padding: 1.25rem 1.5rem;
        }
        .brand a {
          font-size: 1.6rem;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#isi">Lompat ke isi</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand">
          <a href="/">ArticleTemplate<em>.id</em></a>
        </div>
        <nav class="site-nav" aria-label="Navigasi utama">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'active' : undefined}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          {
            loggedIn ? (
              <a class="ghost-link" href="/akun">Akun</a>
            ) : (
              <a class="ghost-link" href="/masuk">Masuk</a>
            )
          }
          <a class="btn" href="/templates">Beli Template</a>
        </div>
        <button
          type="button"
          class="menu-btn"
          id="menu-btn"
          aria-expanded="false"
          aria-controls="sheet-menu"
          aria-label="Buka menu"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </header>
    <div class="wrap">
      <main id="isi">
        <slot />
      </main>
      <footer>
        <p class="footlinks">
          <a href="/templates">Template</a>
          <a href="/harga">Harga</a>
          <a href="/keranjang">Keranjang</a>
          <a href="/konsultasi">Konsultasi</a>
          <a href="/tentang">Tentang</a>
          <a href="/bantuan">Bantuan</a>
          <a href="/bantuan#refund">Refund</a>
          <a href="/bantuan#privasi">Privasi</a>
        </p>
        <p>ArticleTemplate.id, toko template artikel untuk peneliti.</p>
      </footer>
    </div>

    <div class="sheet-overlay" id="sheet-overlay" hidden></div>
    <div class="sheet" id="sheet-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <div class="sheet-head">
        <div class="brand">
          <a href="/">ArticleTemplate<em>.id</em></a>
        </div>
        <button type="button" class="sheet-close" id="sheet-close" aria-label="Tutup menu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <nav aria-label="Navigasi utama (menu)">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={isActive(item.href) ? 'active' : undefined}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="sheet-actions">
        <a class="btn" href="/templates">Beli Template</a>
        {
          loggedIn ? (
            <a class="btn ghost" href="/akun">Akun saya</a>
          ) : (
            <a class="btn ghost" href="/masuk">Masuk</a>
          )
        }
      </div>
      <p class="sheet-foot">
        <a href="/bantuan">Bantuan</a> · <a href="/tentang">Tentang</a>
      </p>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('menu-btn');
        var sheet = document.getElementById('sheet-menu');
        var overlay = document.getElementById('sheet-overlay');
        var closeBtn = document.getElementById('sheet-close');
        if (!btn || !sheet || !overlay || !closeBtn) return;
        var lastFocus = null;
        function open() {
          lastFocus = document.activeElement;
          sheet.hidden = false;
          overlay.hidden = false;
          requestAnimationFrame(function () {
            sheet.classList.add('open');
            overlay.classList.add('open');
          });
          document.body.style.overflow = 'hidden';
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-label', 'Tutup menu');
          closeBtn.focus();
        }
        function close() {
          sheet.classList.remove('open');
          overlay.classList.remove('open');
          document.body.style.overflow = '';
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Buka menu');
          setTimeout(function () {
            sheet.hidden = true;
            overlay.hidden = true;
          }, 220);
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        btn.addEventListener('click', function () {
          if (sheet.classList.contains('open')) close();
          else open();
        });
        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && sheet.classList.contains('open')) close();
        });
      })();
    </script>
  </body>
</html>
