---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Template artikel untuk peneliti: beli, bayar, unduh, dan kelola dari akunmu.',
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Beranda', icon: 'home' },
  { href: '/templates', label: 'Template', icon: 'file' },
  { href: '/keranjang', label: 'Keranjang', icon: 'cart' },
  { href: '/konsultasi', label: 'Konsultasi', icon: 'chat' },
  { href: '/akun', label: 'Akun', icon: 'user' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const icons: Record<string, string> = {
  home: 'M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10',
  file: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  cart: 'M3 4h2l2.4 11h10.2L20 7H6.2M9 20a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z',
  chat: 'M4 5h16v11H9l-5 4z',
  user: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c0-4 3.6-7 8-7s8 3 8 7',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#fbfaf7" />
    <meta name="color-scheme" content="light" />
    <title>{title} — ArticleTemplate.id</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — ArticleTemplate.id`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <style is:global>
      :root {
        --paper: #fbfaf7;
        --surface: #ffffff;
        --ink: #1f2937;
        --muted: #5b6470;
        --line: #e7e2d6;
        --accent: #1b4d3e;
        --accent-soft: #e9efea;
        --badge-bg: #fef3c7;
        --badge-line: #e5c07b;
        --badge-ink: #92400e;
        --tab-h: 60px;
        --gutter: 16px;
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-tap-highlight-color: transparent;
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--paper);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.65;
        overflow-wrap: anywhere;
      }
      a {
        color: var(--accent);
        text-underline-offset: 3px;
      }
      a,
      button,
      [role="button"] {
        touch-action: manipulation;
      }
      img,
      svg,
      video {
        max-width: 100%;
      }
      input,
      textarea,
      select {
        font: inherit;
        font-size: 16px;
        min-height: 44px;
      }
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 6px;
      }
      .skip {
        position: absolute;
        left: var(--gutter);
        top: -60px;
        background: var(--accent);
        color: #fff;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        z-index: 100;
      }
      .skip:focus {
        top: 8px;
      }

      /* ---------- layout (mobile-first) ---------- */
      .wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 var(--gutter);
        padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
        padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
        padding-bottom: calc(
          var(--tab-h) + env(safe-area-inset-bottom, 0px) + 1.5rem
        );
      }
      header {
        padding: calc(0.9rem + env(safe-area-inset-top, 0px)) 0 0.9rem;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.15rem 0.75rem;
      }
      .brand a {
        color: var(--ink);
        text-decoration: none;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .brand a em {
        font-style: normal;
        color: var(--accent);
      }
      .tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
      }

      /* Bottom tab bar: HP. Pindah jadi nav atas di layar lebar. */
      nav.tabs {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 50;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        background: rgba(255, 255, 255, 0.96);
        border-top: 1px solid var(--line);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      nav.tabs a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        min-height: var(--tab-h);
        color: var(--muted);
        text-decoration: none;
        font-size: 0.72rem;
        font-weight: 600;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
        transition: color 120ms var(--ease-out), transform 120ms var(--ease-out);
      }
      nav.tabs a svg {
        width: 24px;
        height: 24px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      nav.tabs a:active {
        transform: scale(0.94);
      }
      nav.tabs a.active {
        color: var(--accent);
      }
      nav.tabs a.active svg {
        stroke-width: 2.3;
      }

      main {
        padding-top: 1.5rem;
      }
      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.7rem, 6vw, 2.7rem);
        line-height: 1.15;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
      }
      h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.3rem;
        line-height: 1.3;
        margin: 2rem 0 0.75rem;
      }
      p {
        margin: 0 0 1rem;
      }
      ol {
        padding-left: 1.4rem;
      }
      ol li {
        margin-bottom: 0.5rem;
      }
      code {
        background: #f1efe9;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        font-size: 0.9em;
      }
      .badge {
        display: inline-block;
        background: var(--badge-bg);
        border: 1px solid var(--badge-line);
        color: var(--badge-ink);
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
        margin: 1rem 0;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        box-shadow: 0 1px 2px rgba(28, 25, 23, 0.06);
      }
      .grid .card {
        margin: 0;
      }
      .card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.08rem;
      }
      .card p {
        color: var(--muted);
      }
      .card p:last-child {
        margin-bottom: 0;
      }
      button,
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        background: var(--accent);
        color: #fff;
        border: 0;
        border-radius: 999px;
        padding: 0.6rem 1.25rem;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        transition: transform 120ms var(--ease-out), background 120ms;
      }
      button:active,
      .btn:active {
        transform: scale(0.97);
      }
      button:disabled {
        background: #e7e5e4;
        color: #57534e;
        cursor: not-allowed;
        transform: none;
      }
      /* ---------- form + pesan (dipakai halaman auth dll) ---------- */
      .form {
        display: grid;
        gap: 0.9rem;
        max-width: 420px;
      }
      .form .field {
        display: grid;
        gap: 0.3rem;
        font-weight: 600;
        font-size: 0.9rem;
      }
      .form .field input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 0.5rem 0.8rem;
        background: var(--surface);
        color: var(--ink);
        font-weight: 400;
      }
      .form .hint {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 400;
      }
      .notice {
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin: 0 0 1rem;
        background: var(--badge-bg);
        border: 1px solid var(--badge-line);
        color: var(--badge-ink);
      }
      .notice.ok {
        background: var(--accent-soft);
        border-color: #b9ccc1;
        color: var(--accent);
      }
      .linkrow {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        margin-top: 1rem;
      }
      .linkrow a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .btn.ghost {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
      }
      footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-size: 0.9rem;
        color: var(--muted);
      }
      footer p {
        margin: 0;
      }

      /* ---------- hover hanya untuk mouse ---------- */
      @media (hover: hover) and (pointer: fine) {
        a:hover {
          text-decoration-thickness: 2px;
        }
        nav.top a:hover {
          background: var(--accent-soft);
          color: var(--accent);
        }
        button:not(:disabled):hover,
        .btn:hover {
          background: #153d31;
        }
      }

      /* ---------- layar lebar: nav atas, bukan tab bawah ---------- */
      nav.top {
        display: none;
      }
      @media (min-width: 720px) {
        :root {
          --gutter: 24px;
        }
        .wrap {
          padding-bottom: 3rem;
        }
        nav.tabs {
          display: none;
        }
        nav.top {
          display: flex;
          flex-wrap: wrap;
          gap: 0.25rem;
          margin-top: 0.75rem;
        }
        nav.top a {
          display: inline-flex;
          align-items: center;
          min-height: 44px;
          color: var(--muted);
          text-decoration: none;
          font-weight: 600;
          font-size: 0.95rem;
          padding: 0 0.9rem;
          border-radius: 999px;
        }
        nav.top a.active {
          background: var(--accent);
          color: #fff;
        }
        main {
          padding-top: 2.5rem;
        }
        .grid {
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
        }
        .card {
          padding: 1.25rem 1.5rem;
        }
        .brand a {
          font-size: 1.6rem;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#isi">Lompat ke isi</a>
    <div class="wrap">
      <header>
        <div class="brand">
          <a href="/">ArticleTemplate<em>.id</em></a>
          <p class="tagline">Template artikel untuk peneliti</p>
        </div>
        <nav class="top" aria-label="Navigasi utama">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'active' : undefined}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="isi">
        <slot />
      </main>
      <footer>
        <p>
          ArticleTemplate.id — toko template artikel untuk peneliti. Harga dan
          layanan konsultasi menyusul.
        </p>
      </footer>
    </div>
    <nav class="tabs" aria-label="Navigasi utama (mobile)">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={isActive(item.href) ? 'active' : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[item.icon]} />
            </svg>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>
  </body>
</html>
