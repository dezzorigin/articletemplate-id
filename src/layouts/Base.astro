---
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/templates', label: 'Template' },
  { href: '/keranjang', label: 'Keranjang' },
  { href: '/konsultasi', label: 'Konsultasi' },
  { href: '/akun', label: 'Akun saya' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — ArticleTemplate.id</title>
    <meta
      name="description"
      content="Template artikel untuk peneliti: beli, bayar lewat BorderPay, unduh, dan kelola dari akunmu."
    />
    <style>
      :root {
        --paper: #fbfaf7;
        --surface: #ffffff;
        --ink: #1f2937;
        --muted: #5b6470;
        --line: #e7e2d6;
        --accent: #1b4d3e;
        --accent-soft: #e9efea;
        --badge-bg: #fef3c7;
        --badge-line: #e5c07b;
        --badge-ink: #92400e;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.65;
      }
      a {
        color: var(--accent);
        text-underline-offset: 3px;
      }
      a:hover {
        text-decoration-thickness: 2px;
      }
      .wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem 3rem;
      }
      header {
        padding: 1.75rem 0 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.75rem;
      }
      .brand a {
        color: var(--ink);
        text-decoration: none;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .brand a em {
        font-style: normal;
        color: var(--accent);
      }
      .tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        margin-top: 1.25rem;
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
      }
      nav a:hover {
        background: var(--accent-soft);
        color: var(--accent);
      }
      nav a.active {
        background: var(--accent);
        color: #fff;
      }
      main {
        padding-top: 2.5rem;
      }
      h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4vw, 2.7rem);
        line-height: 1.15;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
      }
      h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.45rem;
        line-height: 1.3;
        margin: 2.5rem 0 0.75rem;
      }
      p {
        margin: 0 0 1rem;
      }
      ol {
        padding-left: 1.4rem;
      }
      ol li {
        margin-bottom: 0.5rem;
      }
      code {
        background: #f1efe9;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        font-size: 0.9em;
      }
      .badge {
        display: inline-block;
        background: var(--badge-bg);
        border: 1px solid var(--badge-line);
        color: var(--badge-ink);
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin: 1rem 0;
      }
      @media (min-width: 720px) {
        .grid {
          grid-template-columns: 1fr 1fr;
        }
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 1px 2px rgba(28, 25, 23, 0.06);
      }
      .grid .card {
        margin: 0;
      }
      .card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.08rem;
      }
      .card p {
        color: var(--muted);
      }
      .card p:last-child {
        margin-bottom: 0;
      }
      button {
        background: var(--accent);
        color: #fff;
        border: 0;
        border-radius: 999px;
        padding: 0.55rem 1.15rem;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:disabled {
        background: #e7e5e4;
        color: #78716c;
        cursor: not-allowed;
      }
      footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-size: 0.9rem;
        color: var(--muted);
      }
      footer p {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="brand">
          <a href="/">ArticleTemplate<em>.id</em></a>
          <p class="tagline">Template artikel untuk peneliti</p>
        </div>
        <nav>
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'active' : undefined}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>
          ArticleTemplate.id — toko template artikel untuk peneliti. Harga dan
          layanan konsultasi menyusul (placeholder, lihat PRD).
        </p>
      </footer>
    </div>
  </body>
</html>
