---
// Shell admin (redesign v2): delegasi ke Dashboard.astro — shell bersama
// admin + buyer (pola "Dashboard with Collapsible Sidebar" 21st.dev).
// Satu-satunya yang spesifik admin di sini: item sidebar + label area.
// Semua gaya, lipat sidebar, dan toggle mode gelap hidup di Dashboard.astro.
import Dashboard from './Dashboard.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const adminNav = [
  { href: '/admin', label: 'Dashboard', icon: 'grid' },
  { href: '/admin/produk', label: 'Produk', icon: 'box' },
  { href: '/admin/order', label: 'Order', icon: 'receipt' },
  { href: '/admin/konten', label: 'Konten', icon: 'file' },
];
---

<Dashboard title={title} eyebrow="Area admin" nav={adminNav}>
  <slot />
</Dashboard>
