---
import Base from '../layouts/Base.astro';
import AuthSplit from '../components/AuthSplit.astro';

// Hanya bisa dipakai bila sesi sudah ada dari tautan email (/auth/callback).
if (!Astro.locals.user) return Astro.redirect('/masuk?e=tautan');

const messages: Record<string, string> = {
  sandi: 'Kata sandi harus 8 sampai 72 karakter.',
  beda: 'Kedua kata sandi tidak sama.',
  gagal: 'Kata sandi belum berhasil diubah. Minta tautan baru lalu coba lagi.',
};
const code = Astro.url.searchParams.get('e');
const error = code ? messages[code] : undefined;
---

<Base title="Atur kata sandi">
  <AuthSplit title="Atur kata sandi" lead="Pilih kata sandi baru untuk akunmu.">
    {error ? <p class="notice" role="alert">{error}</p> : null}
    <form class="form" method="post" action="/auth/atur">
      <label class="field">
        <span>Kata sandi baru</span>
        <input type="password" name="password" required autocomplete="new-password" minlength="8" maxlength="72" />
        <span class="hint">Minimal 8 karakter.</span>
      </label>
      <label class="field">
        <span>Ulangi kata sandi</span>
        <input type="password" name="ulangi" required autocomplete="new-password" minlength="8" maxlength="72" />
      </label>
      <button type="submit">Simpan kata sandi</button>
    </form>
  </AuthSplit>
</Base>

<style>
  .form {
    max-width: none;
  }
</style>
