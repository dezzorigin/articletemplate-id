---
import Base from '../layouts/Base.astro';
import AuthSplit from '../components/AuthSplit.astro';

const ok = Astro.url.searchParams.get('ok') === 'terkirim';
const code = Astro.url.searchParams.get('e');
const messages: Record<string, string> = {
  email: 'Format email tidak valid.',
  tautan:
    'Tautan reset tidak bisa dipakai (misalnya dibuka di browser lain). Minta tautan baru, lalu buka tautan itu di browser yang sama — atau masukkan kode 6 digit dari email baru tanpa mengklik tautannya.',
};
const error = code ? messages[code] : undefined;
---

<Base title="Lupa kata sandi">
  <AuthSplit title="Lupa kata sandi" lead="Kami kirim tautan untuk mengatur kata sandi baru ke email akunmu.">
    {error ? <p class="notice" role="alert">{error}</p> : null}
    {
      ok ? (
        <>
          <p class="notice ok" role="status">
            Jika email itu terdaftar, tautan untuk mengatur kata sandi sudah dikirim. Cek kotak masuk dan folder spam.
          </p>
          <p class="notice" role="note">
            Atau masukkan kode 6 digit dari email itu di{' '}
            <a href="/konfirmasi-kode?jenis=recovery">halaman konfirmasi kode</a> — tanpa mengklik tautannya.
          </p>
        </>
      ) : (
        <form class="form" method="post" action="/auth/lupa">
          <label class="field">
            <span>Email akunmu</span>
            <input type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" maxlength="254" />
          </label>
          <button type="submit">Kirim tautan</button>
        </form>
      )
    }
    <div class="linkrow">
      <a href="/masuk">Kembali ke masuk</a>
    </div>
  </AuthSplit>
</Base>

<style>
  .form {
    max-width: none;
  }
</style>
