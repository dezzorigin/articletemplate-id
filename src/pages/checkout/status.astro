---
import Base from '../../layouts/Base.astro';
import { getOrderView } from '../../lib/orders';
import { formatRupiah } from '../../lib/money';

const order = await getOrderView(Astro.url.searchParams.get('order') ?? '');
if (!order) return Astro.rewrite('/404');

const label: Record<string, string> = {
  menunggu_bayar: 'Menunggu pembayaran',
  lunas: 'Lunas',
  gagal: 'Pembayaran gagal',
  kedaluwarsa: 'Kedaluwarsa',
};
---

<Base title="Status pesanan">
  <h1>Status pesanan</h1>
  <p><span class="badge">{label[order.status]}</span></p>

  <ul class="lines">
    {
      order.items.map((i) => (
        <li class="card line">
          <span>{i.judul}</span>
          <strong>{formatRupiah(i.harga_saat_beli)}</strong>
        </li>
      ))
    }
  </ul>
  <p class="total"><span>Total</span> <strong>{formatRupiah(order.total)}</strong></p>

  {
    order.status === 'menunggu_bayar' ? (
      <p class="notice">Pembayaran belum tersedia (tahap berikutnya, WES-16). Pesananmu sudah tercatat.</p>
    ) : null
  }
</Base>

<style>
  .lines {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: grid;
    gap: 0.5rem;
  }
  .line {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .total {
    display: flex;
    justify-content: space-between;
    font-size: 1.15rem;
  }
</style>
