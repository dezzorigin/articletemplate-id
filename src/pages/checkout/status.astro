---
import Base from '../../layouts/Base.astro';
import { getOrderView } from '../../lib/orders';
import { formatRupiah } from '../../lib/money';
import { getBorderPayPayment, isMockEnabled, isRealBorderPayRef } from '../../lib/payments';
import {
  FALLBACK_EWALLET_PROVIDERS,
  FALLBACK_VA_BANKS,
  isBorderPayEnabled,
  listBorderPayMethods,
} from '../../lib/borderpay';
import { getSupabaseAdmin } from '../../lib/supabase';
import { writeCart } from '../../lib/cart';

const order = await getOrderView(Astro.url.searchParams.get('order') ?? '');
if (!order) return Astro.rewrite('/404');

// F-P2-16: keranjang hanya dikosongkan bila sesi login adalah pemilik order.
// Sebelumnya siapa pun yang membuka URL status order lunas mengosongkan
// keranjang browsernya sendiri. getOrderView tidak membawa user_id, jadi
// kepemilikan dicek di sini (server, halaman status saja).
if (order.status === 'lunas' && Astro.locals.user) {
  const { data: ownerRow } = await getSupabaseAdmin()
    .from('orders')
    .select('user_id')
    .eq('id', order.id)
    .maybeSingle();
  if ((ownerRow as any)?.user_id === Astro.locals.user.id) writeCart(Astro.cookies, []);
}
const mock = isMockEnabled();
const borderpay = !mock && isBorderPayEnabled();
// Jejak pembayaran BorderPay (bila ada): tautan bayar + kedaluwarsa.
const bp = order.status === 'menunggu_bayar' && borderpay ? await getBorderPayPayment(order.id) : null;
const bpLive = bp && isRealBorderPayRef(bp.borderpayRef) && bp.payUrl ? bp : null;
const bpExpired = bpLive?.expiresAt ? Date.now() > new Date(bpLive.expiresAt).getTime() : false;
// Daftar bank/penyedia aktif dari BorderPay; bila discovery tidak menjawab,
// pakai daftar fallback (Referensi API adalah sumber utama).
const bpMethods = order.status === 'menunggu_bayar' && borderpay ? await listBorderPayMethods() : null;
const vaBanks = bpMethods && bpMethods.vaBanks.length > 0 ? bpMethods.vaBanks : FALLBACK_VA_BANKS;
const ewalletBanks =
  bpMethods && bpMethods.ewalletBanks.length > 0 ? bpMethods.ewalletBanks : FALLBACK_EWALLET_PROVIDERS;
const code = Astro.url.searchParams.get('e');
const payError: Record<string, string> = {
  bayar: 'Pembayaran belum bisa dibuat. Coba lagi sebentar lagi.',
  metode: 'Metode itu sedang tidak tersedia di BorderPay. Pilih yang lain.',
  bank: 'Pilih bank / penyedia e-wallet yang tersedia.',
};
const error = code ? payError[code] : undefined;

const label: Record<string, string> = {
  menunggu_bayar: 'Menunggu pembayaran',
  lunas: 'Lunas',
  gagal: 'Pembayaran gagal',
  kedaluwarsa: 'Kedaluwarsa',
};
const penjelasan: Record<string, string> = {
  menunggu_bayar: 'Pesananmu sudah dibuat. Selesaikan pembayaran sebelum waktunya habis.',
  lunas: 'Pembayaran diterima. File template sudah bisa diunduh.',
  gagal: 'Pembayaran tidak berhasil. Pesanan ini tidak dilanjutkan.',
  kedaluwarsa: 'Waktu bayar pesanan ini sudah habis. Pesanan ini tidak dilanjutkan.',
};
const statusClass: Record<string, string> = {
  menunggu_bayar: 'wait',
  lunas: 'ok',
  gagal: 'bad',
  kedaluwarsa: 'bad',
};
const icons: Record<string, string> = {
  menunggu_bayar: 'M12 8v5l3 2M12 21a9 9 0 100-18 9 9 0 000 18z',
  lunas: 'M4 12.5l5 5L20 6.5',
  gagal: 'M6 6l12 12M18 6L6 18',
  kedaluwarsa: 'M12 8v5l3 2M12 21a9 9 0 100-18 9 9 0 000 18z',
};
---

<Base title="Status pesanan">
  <h1>Status pesanan</h1>

  <section class={`status-card ${statusClass[order.status]}`} aria-label={`Status: ${label[order.status]}`}>
    <span class="status-ico" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d={icons[order.status]} /></svg>
    </span>
    <div>
      <h2>{label[order.status]}</h2>
      <p>{penjelasan[order.status]}</p>
    </div>
  </section>

  <ul class="lines">
    {
      order.items.map((i) => (
        <li class="card line">
          <span>{i.judul}</span>
          <strong>{formatRupiah(i.harga_saat_beli)}</strong>
        </li>
      ))
    }
  </ul>
  <p class="total"><span>Total</span> <strong>{formatRupiah(order.total)}</strong></p>

  {
    order.status === 'menunggu_bayar' ? (
      mock ? (
        <section class="card sim">
          <h2>Pembayaran (simulasi)</h2>
          <p class="hint">Mode uji: belum ada uang sungguhan. Pilih metode, lalu simulasikan hasilnya.</p>
          <form method="post" action="/checkout/simulasi" class="row">
            <input type="hidden" name="order" value={order.id} />
            <button name="aksi" value="QRIS" class={order.metode === 'QRIS' ? '' : 'ghost'}>QRIS</button>
            <button name="aksi" value="VA" class={order.metode === 'VA' ? '' : 'ghost'}>Virtual Account</button>
            <button name="aksi" value="EWALLET" class={order.metode === 'EWALLET' ? '' : 'ghost'}>E-Wallet</button>
          </form>
          {order.metode ? (
            <form method="post" action="/checkout/simulasi" class="row">
              <input type="hidden" name="order" value={order.id} />
              <button name="aksi" value="lunas">Simulasi sukses</button>
              <button name="aksi" value="gagal" class="ghost">Simulasi gagal</button>
              <button name="aksi" value="kedaluwarsa" class="ghost">Simulasi kedaluwarsa</button>
            </form>
          ) : (
            <p class="hint">Pilih metode dulu.</p>
          )}
        </section>
      ) : borderpay ? (
        <section class="card sim">
          <h2>Pembayaran</h2>
          {error ? (
            <p class="notice" role="alert">{error}</p>
          ) : null}
          {bpLive && !bpExpired ? (
            <>
              <p class="hint">
                {bpLive.metode === 'QRIS'
                  ? 'Scan QRIS di halaman bayar.'
                  : bpLive.metode === 'VA'
                    ? 'Transfer ke nomor Virtual Account di halaman bayar.'
                    : 'Bayar lewat e-wallet di halaman bayar.'}
              </p>
              {bpLive.expiresAt ? (
                <p class="countdown" data-expires={bpLive.expiresAt}>
                  Bayar sebelum {new Date(bpLive.expiresAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' })} WIB.
                </p>
              ) : (
                <p class="hint">Masa berlaku tercantum di halaman bayar BorderPay.</p>
              )}
              <p>
                <a class="btn" href={bpLive.payUrl} target="_blank" rel="noopener">Buka halaman bayar</a>
              </p>
              <p class="hint">Sudah bayar? Status berubah otomatis begitu BorderPay mengonfirmasi. Muat ulang halaman ini untuk memeriksa.</p>
            </>
          ) : (
            <>
              <p class="hint">
                {bpExpired
                  ? 'Kode bayar sebelumnya sudah kedaluwarsa. Buat pembayaran baru di bawah ini.'
                  : 'Pilih metode, lalu buka halaman bayar BorderPay.'}
              </p>
              <form method="post" action="/checkout/borderpay" class="payform">
                <input type="hidden" name="order" value={order.id} />
                <fieldset class="radios">
                  <legend>Pilih metode bayar</legend>
                  <label class="radio-card">
                    <input type="radio" name="aksi" value="QRIS" checked={order.metode !== 'VA' && order.metode !== 'EWALLET'} />
                    <span>QRIS<small>Scan kode QR dari aplikasi apa pun. Berlaku 60 menit.</small></span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="aksi" value="VA" checked={order.metode === 'VA'} />
                    <span>Virtual Account<small>Transfer ke nomor VA bank pilihanmu. Berlaku 24 jam.</small></span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="aksi" value="EWALLET" checked={order.metode === 'EWALLET'} />
                    <span>E-Wallet<small>Bayar lewat DANA, OVO, GoPay, atau ShopeePay.</small></span>
                  </label>
                </fieldset>
                <label class="field">
                  <span>Bank / penyedia e-wallet</span>
                  <select name="bank">
                    <optgroup label="Virtual Account">
                      {
                        vaBanks.map((b) => (
                          <option value={b.code}>{b.name}</option>
                        ))
                      }
                    </optgroup>
                    <optgroup label="E-Wallet">
                      {
                        ewalletBanks.map((b) => (
                          <option value={b.code}>{b.name}</option>
                        ))
                      }
                    </optgroup>
                  </select>
                  <span class="hint">Wajib untuk Virtual Account &amp; E-Wallet; diabaikan untuk QRIS.</span>
                </label>
                <button type="submit">Buat pembayaran</button>
              </form>
            </>
          )}
        </section>
      ) : (
        <p class="notice">Menunggu pembayaran. Halaman ini akan menunjukkan status terbaru saat dimuat ulang.</p>
      )
    ) : order.status === 'lunas' ? (
      <div class="notice ok">
        <p>
          Unduhan tersedia:{' '}
          {order.items.map((i, idx) => (
            <>
              {idx > 0 ? ', ' : ''}
              <a href={`/unduh/${order.id}/${i.product_id}`}>Unduh {i.judul}</a>
            </>
          ))}
          .
        </p>
        <p><a class="btn" href="/akun">Buka dashboard akun</a></p>
      </div>
    ) : (
      <p class="notice">
        Pesanan ini tidak dilanjutkan. Keranjangmu masih tersimpan —{' '}
        <a class="btn" href="/keranjang">Pesan ulang dari keranjang</a>
      </p>
    )
  }

  <script is:inline src="/js/countdown.js"></script>
</Base>

<style>
  .sim {
    display: grid;
    gap: 0.75rem;
  }
  .sim h2 { margin: 0; }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lines {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: grid;
    gap: 0.5rem;
  }
  .line {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .total {
    display: flex;
    justify-content: space-between;
    font-size: 1.15rem;
  }
  .payform { display: grid; gap: 0.9rem; }
  .payform .field { display: grid; gap: 0.3rem; font-weight: 500; font-size: 0.9rem; }
  .payform .field select {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.5rem 0.8rem;
    background: var(--surface);
    color: var(--ink);
    font-weight: 400;
  }
  .payform .hint { color: var(--muted); font-size: 0.85rem; font-weight: 400; }
  .notice .btn { margin-top: 0.5rem; }
</style>
