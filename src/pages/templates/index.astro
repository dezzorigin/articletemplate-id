---
import Base from '../../layouts/Base.astro';
import {
  JENJANG,
  URUTAN,
  parseCatalogQuery,
  listProducts,
  listCatalogFacets,
  isPurchasable,
  formatLabel,
  previewUrl,
  isPreviewImage,
} from '../../lib/catalog';
import { formatRupiah } from '../../lib/money';

const query = parseCatalogQuery(Astro.url.searchParams);
const [{ products, error }, facets] = await Promise.all([listProducts(query), listCatalogFacets()]);
const filtered = Boolean(query.jenjang || query.bidang || query.jurnal || query.q);
const activeCount =
  (query.jenjang ? 1 : 0) + (query.bidang ? 1 : 0) + (query.jurnal ? 1 : 0) + (query.q ? 1 : 0);
---

<Base title="Katalog template" description="Katalog template artikel per jenjang: Scopus Q1 sampai Q4, Sinta, dan Prosiding.">
  <h1>Katalog template</h1>

  <form method="get" class="filter" role="search">
    <label class="field">
      <span>Cari template</span>
      <input
        type="search"
        name="q"
        value={query.q ?? ''}
        placeholder="Judul atau isi template"
        maxlength="60"
        enterkeyhint="search"
        autocomplete="off"
      />
    </label>
    <details class="more" open={Boolean(query.jenjang || query.bidang || query.jurnal) || query.urut !== 'jenjang'}>
      <summary>
        Filter dan urutan{activeCount > 0 ? ` (${activeCount})` : ''}
      </summary>
      <div class="more-body">
        <label class="field">
          <span>Jenjang</span>
          <select name="jenjang">
            <option value="">Semua jenjang</option>
            {
              JENJANG.map((j) => (
                <option value={j} selected={query.jenjang === j}>
                  {j}
                </option>
              ))
            }
          </select>
        </label>
        {facets.bidang.length > 0 ? (
          <label class="field">
            <span>Bidang</span>
            <select name="bidang">
              <option value="">Semua bidang</option>
              {facets.bidang.map((b) => (
                <option value={b} selected={query.bidang === b}>
                  {b}
                </option>
              ))}
            </select>
          </label>
        ) : null}
        {facets.jurnal.length > 0 ? (
          <label class="field">
            <span>Jurnal target</span>
            <select name="jurnal">
              <option value="">Semua jurnal</option>
              {facets.jurnal.map((j) => (
                <option value={j} selected={query.jurnal === j}>
                  {j}
                </option>
              ))}
            </select>
          </label>
        ) : null}
        <label class="field">
          <span>Urutkan</span>
          <select name="urut">
            {
              Object.entries(URUTAN).map(([value, label]) => (
                <option value={value} selected={query.urut === value}>
                  {label}
                </option>
              ))
            }
          </select>
        </label>
      </div>
      <div class="actions">
        <button type="submit">Terapkan</button>
        {filtered || query.urut !== 'jenjang' ? <a class="reset" href="/templates">Atur ulang</a> : null}
      </div>
    </details>
  </form>

  {error ? <p class="notice" role="alert">{error}</p> : null}

  {
    !error && products.length === 0 ? (
      <div class="card empty">
        <strong>{filtered ? 'Tidak ada template yang cocok' : 'Katalog segera hadir'}</strong>
        <p>
          {filtered
            ? 'Coba kata kunci lain atau atur ulang filter.'
            : 'Template pertama sedang disiapkan. Kembali lagi sebentar lagi.'}
        </p>
        {filtered ? <a class="btn" href="/templates">Lihat semua template</a> : null}
      </div>
    ) : null
  }

  {
    products.length > 0 ? (
      <>
        <p class="count" aria-live="polite">{products.length} template</p>
        <div class="grid catalog">
          {products.map((p) => (
            <article class="product">
              <a class="thumb" href={`/templates/${p.slug}`} tabindex="-1" aria-hidden="true">
                {isPreviewImage(p.preview_path) ? (
                  <img src={previewUrl(p.preview_path)!} alt="" loading="lazy" width="640" height="480" />
                ) : (
                  <span class="thumb-empty">{p.jenjang}</span>
                )}
              </a>
              <div class="body">
                <div class="tags">
                  <span class="badge">{p.jenjang}</span>
                  {formatLabel(p.format) ? <span class="fmt">{formatLabel(p.format)}</span> : null}
                </div>
                <h2><a class="stretch" href={`/templates/${p.slug}`}>{p.judul}</a></h2>
                {p.deskripsi ? <p class="desc">{p.deskripsi}</p> : null}
                <div class="foot">
                  {isPurchasable(p.harga) ? (
                    <span class="price">{formatRupiah(p.harga)}</span>
                  ) : (
                    <span class="soon">Segera dijual</span>
                  )}
                  <span class="go" aria-hidden="true">Lihat
                    <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </>
    ) : null
  }
</Base>

<style>
  .filter {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .field {
    display: grid;
    gap: 0.3rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .field input,
  .field select {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.5rem 0.8rem;
    background: var(--surface);
    color: var(--ink);
    font-weight: 400;
  }
  .more {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .more summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .more-body {
    display: grid;
    gap: 0.75rem;
    padding: 0 0.9rem 0.9rem;
  }
  .more .actions {
    padding: 0 0.9rem 0.9rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .reset {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .notice {
    background: var(--warn-bg);
    border: 1px solid var(--warn-line);
    color: var(--warn-ink);
    border-radius: 12px;
    padding: 0.75rem 1rem;
  }
  /* Kartu produk: seluruh kartu bisa diklik (tautan judul diregangkan),
     thumbnail dipotong rasio 4:3 dari bagian atas halaman pertama supaya
     tinggi kartu seragam, deskripsi dibatasi 3 baris. */
  .catalog {
    gap: 1rem;
  }
  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 160ms var(--ease-out), box-shadow 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--code-bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 400ms var(--ease-out);
  }
  .thumb-empty {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.2rem;
    color: var(--line-strong);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.15rem 1.1rem;
    flex: 1;
  }
  .tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .fmt {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .product h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .product h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .stretch:focus-visible::after {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .price {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .soon {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent-dark);
  }
  .go svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .product:hover {
      border-color: var(--line-strong);
      box-shadow: 0 10px 30px -18px rgba(28, 25, 23, 0.35);
      transform: translateY(-2px);
    }
    .product:hover .thumb img {
      transform: scale(1.03);
    }
    .product:hover .go svg {
      transform: translateX(3px);
    }
  }
  @media (min-width: 1000px) {
    .catalog {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 720px) {
    .more-body {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
