---
import Base from '../layouts/Base.astro';
import AuthSplit from '../components/AuthSplit.astro';
import { safeNext, googleEnabled } from '../lib/auth';

if (Astro.locals.user) return Astro.redirect('/akun');

const next = safeNext(Astro.url.searchParams.get('next'));
const code = Astro.url.searchParams.get('e');
const messages: Record<string, string> = {
  salah: 'Email atau kata sandi salah.',
  konfirmasi: 'Email kamu belum dikonfirmasi. Cek kotak masuk untuk tautan konfirmasi.',
  tautan: 'Tautan tidak valid atau sudah kedaluwarsa. Minta tautan baru.',
  google: 'Masuk dengan Google belum tersedia.',
};
const error = code ? messages[code] : undefined;
---

<Base title="Masuk">
  <AuthSplit title="Masuk" lead="Masuk untuk melihat order dan mengunduh template yang sudah kamu beli.">
    {error ? <p class="notice" role="alert">{error}</p> : null}

    {
      googleEnabled() ? (
        <>
          <p class="google">
            <a class="btn ghost google-btn" href={`/auth/google?next=${encodeURIComponent(next)}`}>Masuk dengan Google</a>
          </p>
          <p class="divider" role="separator"><span>atau masuk dengan email</span></p>
        </>
      ) : null
    }

    <form class="form" method="post" action="/auth/masuk">
      <input type="hidden" name="next" value={next} />
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" maxlength="254" />
      </label>
      <label class="field">
        <span>Kata sandi</span>
        <input type="password" name="password" required autocomplete="current-password" minlength="8" maxlength="72" />
      </label>
      <p class="forgot"><a href="/lupa-password">Lupa kata sandi?</a></p>
      <button type="submit">Masuk</button>
    </form>

    <div class="linkrow">
      <a href="/daftar">Belum punya akun? Daftar</a>
      <a href="/admin/masuk">Masuk sebagai admin</a>
    </div>
  </AuthSplit>
</Base>

<style>
  /* Form memakai lebar penuh kolom kartu (bukan 420px global). */
  .form {
    max-width: none;
  }
  /* "Forgot password?" ala pola sign-in: kanan, di atas tombol. */
  .forgot {
    text-align: right;
    font-size: 0.9rem;
    margin: -0.35rem 0 0;
  }
  .google {
    margin: 0 0 0.25rem;
  }
  .google-btn {
    width: 100%;
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.75rem 0 1rem;
  }
  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .divider span {
    white-space: nowrap;
  }
</style>
