---
import Base from '../../layouts/Base.astro';
import { readCart, loadCart } from '../../lib/cart';
import { formatRupiah } from '../../lib/money';

const view = await loadCart(readCart(Astro.cookies));
const empty = view.lines.length === 0;
const payable = view.lines.filter((l) => l.buyable);
---

<Base title="Keranjang">
  <h1>Keranjang</h1>

  {
    empty ? (
      <div class="card">
        <strong>Keranjangmu masih kosong</strong>
        <p>Pilih template yang sesuai jenjang targetmu.</p>
        <a class="btn" href="/templates">Lihat katalog template</a>
      </div>
    ) : (
      <>
        <ul class="lines">
          {view.lines.map((l) => (
            <li class="card line">
              <div class="info">
                <span class="badge">{l.product.jenjang}</span>
                <a class="title" href={`/templates/${l.product.slug}`}>{l.product.judul}</a>
                {l.buyable ? (
                  <span class="price">
                    {formatRupiah(l.product.harga)} / template
                    {l.qty > 1 ? ` — subtotal ${formatRupiah(l.subtotal)}` : ''}
                  </span>
                ) : (
                  <span class="warn">Harga belum final. Produk ini tidak ikut ditagih.</span>
                )}
              </div>
              {l.buyable ? (
                <div class="qty" role="group" aria-label={`Jumlah ${l.product.judul}`}>
                  <form method="post" action="/keranjang/ubah-jumlah">
                    <input type="hidden" name="slug" value={l.product.slug} />
                    <input type="hidden" name="aksi" value="kurang" />
                    <button type="submit" class="ghost qty-btn" aria-label={`Kurangi jumlah ${l.product.judul}`}>−</button>
                  </form>
                  <span class="qty-num" aria-live="polite">{l.qty}</span>
                  <form method="post" action="/keranjang/ubah-jumlah">
                    <input type="hidden" name="slug" value={l.product.slug} />
                    <input type="hidden" name="aksi" value="tambah" />
                    <button type="submit" class="ghost qty-btn" aria-label={`Tambah jumlah ${l.product.judul}`}>+</button>
                  </form>
                </div>
              ) : null}
              <form method="post" action="/keranjang/hapus">
                <input type="hidden" name="slug" value={l.product.slug} />
                <button type="submit" class="ghost" aria-label={`Hapus ${l.product.judul} dari keranjang`}>Hapus</button>
              </form>
            </li>
          ))}
        </ul>

        {view.missing.length > 0 ? (
          <p class="warn">Beberapa template di keranjangmu sudah tidak tersedia dan tidak ikut dihitung.</p>
        ) : null}

        <div class="summary">
          <div>
            <span class="muted">Total ({view.totalQty} template)</span>
            <strong class="total">{formatRupiah(view.total)}</strong>
          </div>
          {payable.length > 0 ? (
            <a class="btn" href="/checkout">Lanjut ke checkout</a>
          ) : (
            <button type="button" disabled>Belum bisa checkout</button>
          )}
        </div>
      </>
    )
  }
</Base>

<style>
  .lines {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .info {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .title {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .price {
    font-weight: 700;
  }
  .warn {
    color: var(--warn-ink);
    font-size: 0.9rem;
  }
  .qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  .qty-btn {
    min-width: 44px;
    padding: 0.6rem 0;
    font-size: 1.1rem;
    line-height: 1;
  }
  .qty-num {
    min-width: 1.5rem;
    text-align: center;
    font-weight: 700;
  }
  .muted {
    color: var(--muted);
    font-size: 0.85rem;
    display: block;
  }
  button.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    flex: none;
  }
  .summary {
    position: sticky;
    bottom: env(safe-area-inset-bottom, 0px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem calc(var(--gutter) * -1) 0;
    padding: 0.75rem var(--gutter);
    background: rgba(255, 255, 255, 0.97);
    border-top: 1px solid var(--line);
    z-index: 40;
  }
  .total {
    font-size: 1.25rem;
  }
  @media (min-width: 720px) {
    .summary {
      bottom: 0;
      margin: 1.5rem 0 0;
      border-radius: 14px 14px 0 0;
    }
  }
</style>
