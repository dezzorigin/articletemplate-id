---
import Dashboard from '../../layouts/Dashboard.astro';
import { cleanName } from '../../lib/auth';

// Dashboard buyer (redesign v2): profil di shell bersama admin + buyer.
const buyerNav = [
  { href: '/akun', label: 'Pesanan', icon: 'receipt' },
  { href: '/akun/profil', label: 'Profil', icon: 'user' },
  { href: '/templates', label: 'Template', icon: 'file' },
  { href: '/harga', label: 'Harga', icon: 'tag' },
];

// Ubah profil (PRD §6): nama pembeli. Kata sandi tidak diubah di sini —
// alurnya lewat tautan email ("Lupa kata sandi" / "Ubah kata sandi").
// Middleware sudah memastikan user ada (redirect ke /masuk bila belum).
// RLS mengizinkan pembeli mengubah kolom `nama` miliknya sendiri.
const user = Astro.locals.user!;
const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('nama')
  .eq('id', user.id)
  .maybeSingle();

let nama = profile?.nama ?? '';
let errors: string[] = [];
const saved = Astro.url.searchParams.get('ok') === '1';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const next = cleanName(form.get('nama'));
  if (!next) {
    errors.push('Nama wajib diisi (maksimal 80 karakter).');
  } else {
    const { error } = await Astro.locals.supabase
      .from('profiles')
      .update({ nama: next })
      .eq('id', user.id);
    if (error) {
      console.error('[akun] gagal simpan profil:', error.message);
      errors.push('Profil gagal disimpan. Coba lagi sebentar lagi.');
    } else {
      return Astro.redirect('/akun/profil?ok=1', 303);
    }
  }
  const raw = form.get('nama');
  nama = typeof raw === 'string' ? raw : nama;
}
---

<Dashboard title="Ubah profil" eyebrow="Akun saya" nav={buyerNav}>
  <h1>Ubah profil</h1>
  {saved ? <p class="notice ok" role="status">Profil berhasil disimpan.</p> : null}
  {errors.length ? (
    <div class="notice" role="alert">
      <ul class="errs">{errors.map((e) => <li>{e}</li>)}</ul>
    </div>
  ) : null}

  <div class="card profil-card">
    <form class="form" method="post">
      <label class="field">
        <span>Nama</span>
        <input type="text" name="nama" required autocomplete="name" maxlength="80" value={nama} />
        <span class="hint">Nama tampil di akun dan pesananmu.</span>
      </label>
      <p class="hint">Email tidak bisa diubah di sini ({user.email}).</p>
      <button type="submit">Simpan profil</button>
    </form>
  </div>

  <div class="linkrow">
    <a href="/atur-password">Ubah kata sandi</a>
  </div>
</Dashboard>

<style>
  .errs { margin: 0; padding-left: 1.2rem; }
  .profil-card {
    max-width: 560px;
  }
  .profil-card .form {
    max-width: none;
  }
</style>
