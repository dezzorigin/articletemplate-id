---
import Admin from '../../../layouts/Admin.astro';
import { formatRupiah } from '../../../lib/money';
import { isBorderPayTestMode } from '../../../lib/borderpay';
import { requireAdmin, adminListOrders, parseOrderQuery, ORDER_STATUS } from '../../../lib/admin';

export const prerender = false;
if (!(await requireAdmin(Astro.locals.supabase, Astro.locals.user))) return Astro.rewrite('/404');

const testMode = isBorderPayTestMode();
const pesan = Astro.url.searchParams.get('m') ?? '';
const query = parseOrderQuery(Astro.url.searchParams);
const orders = await adminListOrders(query);
const label: Record<string, string> = { menunggu_bayar: 'Menunggu bayar', lunas: 'Lunas', gagal: 'Gagal', kedaluwarsa: 'Kedaluwarsa' };
const waktu = (s: string) => new Date(s).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' });
---

<Admin title="Admin · Order">
  <p><a href="/admin">← Dashboard</a></p>
  <h1>Order</h1>

  <form class="filter" method="get">
    <input type="search" name="q" value={query.q ?? ''} placeholder="Cari email pembeli atau produk" maxlength="100" aria-label="Cari" autocapitalize="none" />
    <select name="status" aria-label="Status">
      <option value="">Semua status</option>
      {ORDER_STATUS.map((s) => <option value={s} selected={query.status === s}>{label[s]}</option>)}
    </select>
    <button type="submit">Cari</button>
  </form>

  {pesan === 'simulasi-ok' ? <p class="hint" role="status">Simulasi terkirim. Status berubah lewat webhook, muat ulang bila belum lunas.</p> : null}
  {pesan.startsWith('simulasi-gagal') ? <p class="hint" role="alert">Simulasi ditolak BorderPay ({pesan.replace('simulasi-gagal-', 'HTTP ')}). Cek log server.</p> : null}
  <p class="hint">{orders.length} order{orders.length === 100 ? ' (100 terbaru)' : ''}.</p>

  {orders.length === 0 ? <div class="card"><p>Tidak ada order yang cocok.</p></div> : (
    <div class="tabel-wrap">
      <table class="riwayat">
        <thead>
          <tr>
            <th scope="col">Status</th>
            <th scope="col">Pembeli</th>
            <th scope="col">Produk</th>
            <th scope="col">Total</th>
            <th scope="col">Waktu</th>
          </tr>
        </thead>
        <tbody>
          {orders.map((o) => (
            <tr>
              <td data-label="Status"><span class={`badge st-${o.status}`}>{label[o.status]}</span></td>
              <td data-label="Pembeli">
                <span class="who">{o.nama ? `${o.nama} · ` : ''}{o.email}</span>
                {o.metode ? <span class="hint"> · {o.metode}</span> : null}
              </td>
              <td data-label="Produk">
                <ul class="items">
                  {o.items.map((i) => <li>{i.judul} · {formatRupiah(i.harga_saat_beli)}</li>)}
                </ul>
              </td>
              <td data-label="Total"><strong>{formatRupiah(o.total)}</strong></td>
              <td data-label="Waktu">
                <span class="hint">{waktu(o.created_at)}</span>
                <br />
                <span class="hint">Unduhan: {o.unduhan} · <code>{o.id}</code></span>
                {testMode && o.status === 'menunggu_bayar' && o.metode ? (
                  <form method="post" action="/admin/order/simulasi">
                    <input type="hidden" name="order" value={o.id} />
                    <button type="submit" class="sim">Simulasi bayar (test)</button>
                  </form>
                ) : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Admin>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .card p:last-child {
    margin-bottom: 0;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--muted);
  }
  code {
    overflow-wrap: anywhere;
    font-size: 0.78rem;
    background: var(--code-bg);
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
  }
  .badge {
    display: inline-block;
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 0.05rem 0.5rem;
    border-radius: 4px;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .badge.st-lunas {
    background: var(--st-ok-bg);
    border-color: var(--st-ok-line);
    color: var(--st-ok-ink);
  }
  .badge.st-menunggu_bayar {
    background: var(--st-wait-bg);
    border-color: var(--st-wait-line);
    color: var(--st-wait-ink);
  }
  .badge.st-gagal {
    background: var(--st-bad-bg);
    border-color: var(--st-bad-line);
    color: var(--st-bad-ink);
  }
  .badge.st-kedaluwarsa {
    background: var(--st-mut-bg);
    border-color: var(--st-mut-line);
    color: var(--st-mut-ink);
  }
  .sim {
    margin-top: 0.4rem;
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  /* ---------- filter ---------- */
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }
  .filter input,
  .filter select {
    flex: 1 1 12rem;
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.5rem 0.8rem;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .filter button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: var(--btn-bg);
    color: var(--btn-ink);
    border: 0;
    border-radius: 999px;
    padding: 0.6rem 1.25rem;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  /* ---------- tabel order (desktop) ---------- */
  .tabel-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .riwayat {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .riwayat th,
  .riwayat td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .riwayat tbody tr:last-child th,
  .riwayat tbody tr:last-child td {
    border-bottom: 0;
  }
  .riwayat thead th {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--paper);
    white-space: nowrap;
  }
  .riwayat td:nth-child(4) {
    white-space: nowrap;
  }
  .who {
    overflow-wrap: anywhere;
  }
  .items {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  /* ---------- HP: tabel jadi kartu per order ---------- */
  @media (max-width: 719px) {
    .tabel-wrap {
      border: 0;
      background: transparent;
      overflow: visible;
    }
    .riwayat,
    .riwayat tbody,
    .riwayat tr,
    .riwayat td {
      display: block;
      width: 100%;
    }
    .riwayat thead {
      display: none;
    }
    .riwayat tbody {
      display: grid;
      gap: 0.75rem;
    }
    .riwayat tr {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 0.75rem 1rem;
    }
    .riwayat td {
      border-bottom: 0;
      padding: 0.3rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      align-items: baseline;
    }
    .riwayat td::before {
      content: attr(data-label);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--muted);
      min-width: 4.5rem;
    }
    .riwayat td .items {
      flex: 1;
    }
  }
</style>
