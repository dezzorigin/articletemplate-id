---
import Base from '../../layouts/Base.astro';
import { getSupabaseAdmin } from '../../lib/supabase';
import { requireAdmin } from '../../lib/admin';

export const prerender = false;
// Middleware sudah menolak non-admin (404); dicek ulang di sini sebelum memakai service role.
if (!(await requireAdmin(Astro.locals.supabase, Astro.locals.user))) return Astro.rewrite('/404');

const admin = getSupabaseAdmin();
const head = { count: 'exact' as const, head: true };
const [tampil, total, lunas, menunggu] = await Promise.all([
  admin.from('products').select('id', head).eq('is_visible', true),
  admin.from('products').select('id', head),
  admin.from('orders').select('id', head).eq('status', 'lunas'),
  admin.from('orders').select('id', head).eq('status', 'menunggu_bayar'),
]);
---

<Base title="Admin">
  <h1>Admin</h1>
  <div class="grid">
    <a class="card tile" href="/admin/produk">
      <strong>Produk</strong>
      <p>{tampil.count ?? 0} tampil dari {total.count ?? 0}. Tambah/ubah produk, harga, file, pratinjau, status tampil.</p>
    </a>
    <a class="card tile" href="/admin/order">
      <strong>Order</strong>
      <p>{lunas.count ?? 0} lunas, {menunggu.count ?? 0} menunggu bayar. Cari per email atau produk.</p>
    </a>
    <a class="card tile" href="/admin/konten">
      <strong>Konten</strong>
      <p>Ubah teks halaman Beranda, Tentang, dan Bantuan tanpa edit kode.</p>
    </a>
    <div class="card">
      <strong>Belum tersedia</strong>
      <p>Kirim ulang email lunas/unduhan (menunggu provider email) dan layanan konsultasi (tertutup sampai data mentor masuk).</p>
    </div>
  </div>
</Base>

<style>
  .tile { text-decoration: none; color: inherit; display: block; }
</style>
