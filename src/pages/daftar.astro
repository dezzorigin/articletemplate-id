---
import Base from '../layouts/Base.astro';
import AuthSplit from '../components/AuthSplit.astro';
import { googleEnabled } from '../lib/auth';

if (Astro.locals.user) return Astro.redirect('/akun');

const code = Astro.url.searchParams.get('e');
const ok = Astro.url.searchParams.get('ok') === 'cek-email';
// Isian dipertahankan saat gagal (dikirim balik sebagai ?nama= & ?email=
// oleh POST /auth/daftar; sandi tidak pernah dibawa — selalu kosong).
const namaVal = (Astro.url.searchParams.get('nama') ?? '').slice(0, 80);
const emailVal = (Astro.url.searchParams.get('email') ?? '').slice(0, 254);
const messages: Record<string, string> = {
  email: 'Format email tidak valid.',
  sandi: 'Kata sandi harus 8 sampai 72 karakter.',
  gagal: 'Pendaftaran belum berhasil. Coba lagi sebentar.',
  domain:
    'Domain email ini tidak bisa dipakai untuk pendaftaran (misalnya domain contoh/tes). Gunakan alamat email aktif yang bisa menerima email.',
  nonaktif:
    'Pendaftaran akun baru sedang nonaktif di server. Coba lagi nanti atau hubungi admin.',
  email:
    'Email konfirmasi tidak bisa dikirim dari server. Coba lagi sebentar lagi, atau hubungi admin bila terus gagal.',
  batas: 'Terlalu banyak percobaan pendaftaran. Tunggu sebentar lalu coba lagi.',
  tautan:
    'Tautan konfirmasi tidak bisa dibuat (alamat pengalihan belum diizinkan server). Hubungi admin.',
};
const error = code ? messages[code] : undefined;
---

<Base title="Daftar">
  <AuthSplit title="Daftar" lead="Buat akun untuk membeli template dan mengunduhnya kapan saja dari akunmu.">
    {error ? <p class="notice" role="alert">{error}</p> : null}
    {
      ok ? (
        <>
          <p class="notice ok" role="status">
            Cek email kamu. Jika pendaftaran bisa dilanjutkan, tautan konfirmasi sudah dikirim.
          </p>
          <p class="notice" role="note">
            Tautan tidak bisa dibuka? Masukkan kode 6 digit dari email di{' '}
            <a href={`/konfirmasi-kode?jenis=signup&email=${encodeURIComponent(emailVal)}`}>
              halaman konfirmasi kode
            </a>{' '}
            — tanpa mengklik tautannya.
          </p>
        </>
      ) : (
        <>
          {
            googleEnabled() ? (
              <>
                <p class="google">
                  <a class="btn ghost google-btn" href="/auth/google">Daftar dengan Google</a>
                </p>
                <p class="divider" role="separator"><span>atau daftar dengan email</span></p>
              </>
            ) : null
          }
          <form class="form" method="post" action="/auth/daftar">
            <label class="field">
              <span>Nama</span>
              <input type="text" name="nama" autocomplete="name" maxlength="80" value={namaVal} />
            </label>
            <label class="field">
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="none" autocorrect="off" maxlength="254" value={emailVal} />
            </label>
            <label class="field">
              <span>Kata sandi</span>
              <input type="password" name="password" required autocomplete="new-password" minlength="8" maxlength="72" />
              <span class="hint">Minimal 8 karakter.</span>
            </label>
            <button type="submit">Buat akun</button>
          </form>
        </>
      )
    }
    <div class="linkrow">
      <a href="/masuk">Sudah punya akun? Masuk</a>
    </div>
  </AuthSplit>
</Base>

<style>
  .form {
    max-width: none;
  }
  .google {
    margin: 0 0 0.25rem;
  }
  .google-btn {
    width: 100%;
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.75rem 0 1rem;
  }
  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .divider span {
    white-space: nowrap;
  }
</style>
