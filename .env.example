# Salin menjadi .env untuk lokal (jangan commit .env).
# Di Coolify: isi semua variabel ini lewat dashboard (Environment Variables).
# Aplikasi gagal dengan pesan jelas bila variabel wajib kosong (src/lib/env.ts).
# Backend kanonis: Supabase SELF-HOSTED di Coolify (bukan Supabase Cloud).
# URL + kunci asli diambil dari Environment Variables aplikasi Coolify —
# TIDAK PERNAH di-commit dan tidak ditulis di chat/dokumen.

# URL Kong Supabase self-hosted (Environment Variables aplikasi Coolify).
# Pola: https://<kong-host> — host Kong dari instalasi Supabase self-hosted tim
# (bukan alamat IP literal; IP VPS tidak ditulis di repo).
PUBLIC_SUPABASE_URL=https://<kong-host>

# Anon key (publishable) - aman di frontend, dijaga RLS.
PUBLIC_SUPABASE_ANON_KEY=isi-dari-environment-variables-coolify

# Service role key - HANYA server. TIDAK PERNAH ke frontend, repo, atau chat.
SUPABASE_SERVICE_ROLE_KEY=isi-dari-environment-variables-coolify

# BorderPay (WES-17) — isi dari dashboard BorderPay + Referensi API
# https://borderpay.id/api-reference (dibaca penuh 16 Nov 2026).
# TIDAK PERNAH di-commit.
# - BORDERPAY_API_KEY: key test (bp_test_...) untuk sandbox, key live
#   (bp_live_...) untuk produksi. Hanya server; jangan ke frontend.
#   Mode test/live dipilih prefix key-nya; tidak ada host sandbox terpisah.
# - BORDERPAY_BASE_URL: host API BorderPay — TERKONFIRMASI
#   https://borderpay.id/api/v1 (satu-satunya; host publik, bukan rahasia).
#   Opsional: kosong = pakai nilai itu. Isi hanya bila host berubah.
# - BORDERPAY_WEBHOOK_TOKEN: token verifikasi webhook dari dashboard BorderPay
#   (dibandingkan dengan header request `x-borderpay-token`). Tanpa ini,
#   webhook menjawab 501 dan tidak memproses order.
BORDERPAY_API_KEY=
BORDERPAY_BASE_URL=https://borderpay.id/api/v1
BORDERPAY_WEBHOOK_TOKEN=

# Provider pembayaran: mock = simulasi (hanya jalan di dev; di build produksi
# simulasi selalu mati apa pun nilainya — lihat isMockEnabled di src/lib/payments.ts).
# Produksi nyata = borderpay (WES-17): aktif otomatis bila BORDERPAY_API_KEY
# terisi; tanpa key, halaman status tidak menampilkan tombol bayar.
PAYMENT_PROVIDER=mock
