# Salin file ini menjadi .env (jangan commit .env ke repo).
# Nilai-nilai ini diisi setelah project Supabase dibuat — lihat README.md.

# URL project Supabase (dashboard: Project Settings -> API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key (publishable) — aman dipakai di frontend, dijaga RLS.
PUBLIC_SUPABASE_ANON_KEY=isi-dari-dashboard-supabase

# Service role key — HANYA di server (Worker/API route). TIDAK PERNAH ke
# frontend, repo, atau chat. Dipakai untuk: webhook BorderPay, signed URL.
SUPABASE_SERVICE_ROLE_KEY=isi-dari-dashboard-supabase

# BorderPay — diisi setelah akun merchant aktif (mode test dulu).
BORDERPAY_API_KEY=
BORDERPAY_WEBHOOK_SECRET=
